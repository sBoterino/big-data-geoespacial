# Copiar a .env para desarrollo local:  cp .env.example .env
# .env está en .gitignore. Nunca subir valores reales.
# En Jenkins, Mongo y Kaggle NO se leen de aquí: vienen de las credenciales
# "mongo-root" y "kaggle-api-token". USAR LOS MISMOS VALORES en ambos lados, porque
# comparten el volumen de MongoDB (la contraseña queda fijada al crear el volumen).

# --- MongoDB ---
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=cambiar_esto
MONGO_DB=geo
MONGO_COLLECTION=eventos

# --- Kaggle (Settings -> API -> Generate New Token) ---
KAGGLE_API_TOKEN=
KAGGLE_DATASET=muzammilrizvi1/motor-vehicle-collisions-crashes

# --- Ingesta (Fase 4) ---
# 0 = cargar todo; >0 = muestra (mínimo 1000000 para cumplir el enunciado)
INGEST_MAX_ROWS=0
INGEST_BATCH_SIZE=5000
FORCE_RELOAD=false

# --- Webhook: canal creado en https://smee.io (ver docs/guia_fase2.md) ---
SMEE_URL=

# --- API ---
# En macOS el puerto 5000 lo usa AirPlay: si choca, usar 5001
API_PORT=5000

# --- Recursos (ajustar a la RAM del computador; también sirven para el benchmark) ---
# La suma de límites es ~11,5 GB (el uso real suele ser bastante menor). Con 8 GB en Docker Desktop,
# bajar SPARK_WORKER_CONTAINER_MEM y DASK_WORKER_CONTAINER_MEM a 1536m.
MONGO_MEM=1536m
SPARK_MASTER_MEM=1g
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=1536m
SPARK_WORKER_CONTAINER_MEM=2g
DASK_SCHEDULER_MEM=512m
DASK_WORKER_THREADS=2
DASK_WORKER_MEMORY=1.5GiB
DASK_WORKER_CONTAINER_MEM=2g
API_MEM=512m
JENKINS_MEM=2g
